# Copy this file to .env.local and fill in your own PostgreSQL connection string.
# .env.local is never committed to Git, so your password stays private.

# Local PostgreSQL example:
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/buildadda

# Hosted PostgreSQL (Neon, Supabase, and others) gives you a string like:
# DATABASE_URL=postgres://user:password@host.example.com/buildadda?sslmode=require

# The public address of the site once it's live. Used for link previews and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://buildadda.example.com
